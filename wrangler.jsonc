{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "context-architecture",
  "compatibility_date": "2025-06-12",
  // Official domain. Requires context-architecture.dev to be added as a zone in
  // your Cloudflare account. Remove this block to use only the *.workers.dev
  // subdomain.
  "routes": [{ "pattern": "context-architecture.dev", "custom_domain": true }],
  // Fully static site (SSG): no Worker script (`main`), Cloudflare serves the
  // files prerendered by `nuxt generate` directly.
  "assets": {
    "directory": "./.output/public",
    // No trailing slash, to match the canonical URLs: @nuxtjs/seo declares the
    // canonical and the sitemap routes without a trailing slash (for example
    // /comparison), so Cloudflare must serve that same form with 200 (and
    // redirect /comparison/ to /comparison with 307). With the default
    // `auto-trailing-slash` the opposite happened and the sitemap/canonical
    // pointed at URLs that redirected.
    "html_handling": "drop-trailing-slash",
    // Serve the 404.html Nuxt generates for not-found routes.
    "not_found_handling": "404-page",
  },
}
